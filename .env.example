# Параметры развёртывания Hackathon Tracker.
# Значения по умолчанию соответствуют приложению C технического задания.

# --- Приложение ---
APP_ENV=dev
LOG_LEVEL=info
SYSTEM_TIMEZONE=Europe/Moscow
PUBLIC_URL=http://localhost:5173

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
SWAGGER_ENABLED=true

# --- База данных ---
DATABASE_URL=postgres://hackathon:hackathon@localhost:5432/hackathon?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONN_LIFETIME=1h
# Роль приложения, у которой отзываются UPDATE и DELETE на audit_log.
DATABASE_APP_ROLE=

# --- Аутентификация ---
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
INVITE_TTL=72h
TELEGRAM_LINK_TTL=1h
PASSWORD_MIN_LENGTH=10

# --- Первый администратор (команда `hackathon admin create`) ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Администратор

# --- Argon2id ---
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# --- Ограничения частоты запросов ---
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_RESEND_ATTEMPTS=5
RATE_LIMIT_RESEND_WINDOW=1h

# --- Планировщик и worker ---
SCHEDULER_INTERVAL=5m
SCHEDULER_BATCH_SIZE=500
WORKER_POLL_INTERVAL=5s
WORKER_BATCH_SIZE=20
WORKER_LEASE_TTL=2m
WORKER_RECOVERY_INTERVAL=1m
NOTIFICATION_MAX_PROVIDER_CALLS=4
NOTIFICATION_BACKOFF=1m,5m,30m
NOTIFICATION_MAX_RULES=10
NOTIFICATION_MAX_OFFSET_MINUTES=525600

# --- Сроки хранения ---
RETENTION_NOTIFICATION_PAYLOAD=2160h
RETENTION_AUDIT_LOG=8760h
RETENTION_INTERVAL=24h

# --- Telegram ---
# log — писать сообщения в журнал вместо отправки; bot — реальная отправка.
TELEGRAM_DRIVER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=hackathon_tracker_bot
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=10s

# --- Email ---
# log — писать письма в журнал вместо отправки; smtp — реальная отправка.
EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15s
EMAIL_FROM=no-reply@hackathon.local
EMAIL_FROM_NAME=Hackathon Tracker

# --- Служебное ---
METRICS_TOKEN=
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
USER_SEARCH_PAGE_SIZE=50
