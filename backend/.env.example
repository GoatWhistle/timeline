# Timeline deployment parameters.
# The defaults match appendix C of the technical specification.

# --- Application ---
APP_ENV=dev
LOG_LEVEL=info
SYSTEM_TIMEZONE=Europe/Moscow
PUBLIC_URL=http://localhost:5173

# --- HTTP ---
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
SWAGGER_ENABLED=true

# --- Database ---
DATABASE_URL=postgres://timeline:timeline@localhost:5432/timeline?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_CONN_LIFETIME=1h
# The application role whose UPDATE and DELETE on audit_log are revoked.
DATABASE_APP_ROLE=

# --- Authentication ---
JWT_SECRET=dev-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
INVITE_TTL=72h
TELEGRAM_LINK_TTL=1h
PASSWORD_MIN_LENGTH=10

# --- First administrator (the `timeline admin create` command) ---
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Administrator

# --- Argon2id ---
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# --- Rate limits ---
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_RESEND_ATTEMPTS=5
RATE_LIMIT_RESEND_WINDOW=1h
RATE_LIMIT_CATALOG_REQUESTS=120
RATE_LIMIT_CATALOG_WINDOW=1m
RATE_LIMIT_SESSION_REQUESTS=60
RATE_LIMIT_SESSION_WINDOW=1m
RATE_LIMIT_PREVIEW_REQUESTS=60
RATE_LIMIT_PREVIEW_WINDOW=1m
RATE_LIMIT_QUEUE_REQUESTS=60
RATE_LIMIT_QUEUE_WINDOW=1m
RATE_LIMIT_LINK_REQUESTS=240
RATE_LIMIT_LINK_WINDOW=1m
RATE_LIMIT_PROFILE_REQUESTS=30
RATE_LIMIT_PROFILE_WINDOW=1m

# --- Resource links ---
RESOURCE_LINKS_MAX_PER_EVENT=50
RESOURCE_LINKS_MAX_PERSONAL_PER_EVENT=20

# --- Weekly digest ---
DIGEST_INTERVAL=1h
DIGEST_BATCH=200
DIGEST_MAX_ITEMS=50

# --- Scheduler and worker ---
SCHEDULER_INTERVAL=5m
SCHEDULER_BATCH_SIZE=500
WORKER_POLL_INTERVAL=5s
WORKER_BATCH_SIZE=20
WORKER_LEASE_TTL=2m
WORKER_RECOVERY_INTERVAL=1m
NOTIFICATION_MAX_PROVIDER_CALLS=4
NOTIFICATION_BACKOFF=1m,5m,30m
NOTIFICATION_MAX_RULES=10
NOTIFICATION_MAX_OFFSET_MINUTES=525600

# --- Retention ---
RETENTION_NOTIFICATION_PAYLOAD=2160h
RETENTION_AUDIT_LOG=8760h
RETENTION_SYSTEM_EVENT=2160h
RETENTION_INTERVAL=24h

# --- Telegram ---
# A real bot adapter: point it at a test bot's token in development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=timeline_bot
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT=10s

# --- Email ---
# A real SMTP adapter: point it at a test SMTP server in development
# (Mailpit, MailHog or a provider's sandbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT=15s
EMAIL_FROM=no-reply@timeline.local
EMAIL_FROM_NAME=Timeline

# --- Operational ---
METRICS_TOKEN=
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200
USER_SEARCH_PAGE_SIZE=50

# --- Realtime ---
# One WebSocket connection per tab carries cache invalidation addresses and
# event bus entries. The socket is read-only and is bound to the session, not
# to the 15-minute access token: it is closed on sign-out, session revocation
# and account deactivation.
REALTIME_ENABLED=true
REALTIME_PING_INTERVAL=30s
REALTIME_MAX_CONNECTIONS_PER_USER=8
REALTIME_QUEUE_AGE_THRESHOLD=30m
RATE_LIMIT_FEED_REQUESTS=240
RATE_LIMIT_FEED_WINDOW=1m
RATE_LIMIT_REALTIME_ATTEMPTS=30
RATE_LIMIT_REALTIME_WINDOW=1m
