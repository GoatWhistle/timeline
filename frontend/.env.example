# Базовый путь API. По умолчанию запросы уходят на тот же origin.
VITE_API_BASE_URL=/api/v1

# Включает моки MSW вместо реального backend (1 — включено).
# `make dev` из корня запускает vite с VITE_ENABLE_MSW=0 и прокси на API
# (а `make dev MOCKS=1` — с моками): переменные окружения перекрывают этот
# файл, переписывать его не нужно.
VITE_ENABLE_MSW=1

# Если задан, dev-сервер проксирует /api на реальный backend вместо MSW.
# VITE_API_PROXY=http://localhost:8080
