# The API base path. By default requests go to the same origin.
VITE_API_BASE_URL=/api/v1

# Enables the MSW mocks instead of the real backend (1 - enabled).
# `make dev` from the root starts vite with VITE_ENABLE_MSW=0 and a proxy to the
# API (and `make dev MOCKS=1` - with mocks): environment variables override this
# file, there is no need to rewrite it.
VITE_ENABLE_MSW=1

# If set, the dev server proxies /api to the real backend instead of MSW.
# VITE_API_PROXY=http://localhost:8080
